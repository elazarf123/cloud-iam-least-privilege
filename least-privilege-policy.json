{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowSpecificReadAndWriteStorage",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::enterprise-audit-logs-bucket",
                "arn:aws:s3:::enterprise-audit-logs-bucket/*"
            ]
        },
        {
            "Sid": "DenyUnencryptedObjectUploads",
            "Effect": "Deny",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::enterprise-audit-logs-bucket/*",
            "Condition": {
                "Null": {
                    "s3:x-amz-server-side-encryption": "true"
                }
            }
        }
    ]
}
